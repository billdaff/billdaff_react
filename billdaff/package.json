{
  "name": "billdaff",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://billdaff.com",
  "dependencies": {
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^13.2.1",
    "html-react-parser": "^5.0.6",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint --max-warnings=0 --ext .ts,.tsx src e2e playwright.config.ts playwright.live.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report playwright-report/mocked",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "e2e/**/*.ts"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off",
          "jest/valid-expect": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "^27",
    "@types/node": "^20",
    "@types/react": "^17",
    "@types/react-dom": "^17",
    "typescript": "4.9.5"
  }
}
